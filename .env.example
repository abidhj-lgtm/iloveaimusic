# ============================================================
# I Love AI Music — iloveaimusic.com
# Copy to ".env.local". The app runs with none of these set.
# ============================================================

NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_ENV=development

# --- Database (empty = local JSON store) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (empty = scoped dev inbox) ---
RESEND_API_KEY=
MAIL_FROM="I Love AI Music <no-reply@iloveaimusic.com>"

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Rate limiting: REQUIRED on Vercel ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Staff: the only source of admin rights in production ---
STAFF_EMAILS=abidsumon12@gmail.com

# --- Backups: long random string, 24+ chars ---
BACKUP_TOKEN=

# --- Error reporting (optional but recommended) ---
SENTRY_DSN=

# --- Demo login: leave empty. Defaults off in production. ---
ALLOW_DEMO_LOGIN=

# --- Local store location (E2E overrides this) ---
ILISTENAI_DATA_DIR=

# --- Search console ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=